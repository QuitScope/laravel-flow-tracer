{
    "name": "yourname/laravel-flow-tracer",
    "description": "A powerful Laravel package to trace and visualize application flows with automatic high-quality PNG diagrams using Graphviz",
    "keywords": ["laravel", "flow", "tracer", "visualization", "diagram", "graphviz", "ddd", "architecture"],
    "homepage": "https://github.com/quitscope/laravel-flow-tracer",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dustin Aßmann",
            "email": "your.email@example.com",
            "homepage": "https://github.com/quitscope"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/finder": "^6.0|^7.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelFlowTracer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelFlowTracer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelFlowTracer\\FlowTracerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}